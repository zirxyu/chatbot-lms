# ============ Identitas ============
APP_NAME=Portal LMS Unmul
APP_URL=http://localhost:8000
ADMIN_CONTACT=admin@lms.unmul.ac.id

# ============ WhatsApp ============
SESSION_DIR=./session

# Isi dengan nomor WA bot (format internasional tanpa +) untuk login
# memakai kode pairing tanpa scan QR. Kosongkan untuk mode QR.
PAIRING_PHONE=

# Nomor WA admin yang menerima notifikasi saat bot online (opsional)
BOT_OWNER=

ALLOW_GROUPS=false
MARK_READ=true
RECONNECT_MS=5000
LOG_LEVEL=info

# ============ Server LMS (API) ============
LMS_API_URL=http://localhost:4000/api
LMS_API_KEY=ganti-dengan-api-key-yang-aman
REQUEST_TIMEOUT_MS=15000

# Format NIM yang diterima bot (regex)
NIM_PATTERN="^[0-9]{6,15}$"

# ============ Batasan ============
MAX_VERIFY_ATTEMPTS=5
RATE_WINDOW_MIN=60
SESSION_TTL_MIN=5

# ============ Mock server (khusus development) ============
PORT=4000
MOCK_API_KEY=mock-secret-key
MOCK_SECRET=rahasia-mock-server-ganti-di-produksi-32char
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LMS Unmul <no-reply@lms.unmul.ac.id>"
