# ============ Identitas ============
APP_NAME=LMS-FT-UNMUL
APP_URL=https://smakensaft.my.id
ADMIN_CONTACT=admin@ft.unmul.ac.id

# ============ WhatsApp ============
SESSION_DIR=./session

# Nomor WA bot (tanpa +) untuk pairing tanpa QR. Kosongkan untuk mode QR.
PAIRING_PHONE=

# Nomor WA admin yang menerima notifikasi saat bot online (opsional)
BOT_OWNER=

ALLOW_GROUPS=false
MARK_READ=true
RECONNECT_MS=5000
LOG_LEVEL=info

# ============ SMTP (Gmail) ============
# Untuk Gmail: buat App Password di https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email-kamu@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM=email-kamu@gmail.com

# ============ Server LMS (API) ============
# Untuk testing lokal, arahkan ke mock server: http://localhost:4000
LMS_API_URL=http://localhost:4000
LMS_API_KEY=ganti-dengan-api-key-yang-aman
REQUEST_TIMEOUT_MS=15000

# Format NIM yang diterima bot (regex)
NIM_PATTERN="^[0-9]{6,15}$"

# ============ Batasan ============
MAX_VERIFY_ATTEMPTS=5
RATE_WINDOW_MIN=60
SESSION_TTL_MIN=5
